# =========================
# Server
# =========================
NODE_ENV=development
PORT=5000

# =========================
# Database (PostgreSQL)
# =========================
# Either set the discrete DB_* vars below (local Postgres / Docker), or
# set NEON_BD_URL to a full connection string (e.g. from Neon) and it
# takes priority over the DB_* vars.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=line_chat_app
DB_USER=postgres
DB_PASSWORD=postgres
# NEON_BD_URL=postgresql://user:password@host/dbname?sslmode=require

# =========================
# CORS
# =========================
# Comma-separated list of allowed frontend origins.
# Add your deployed Vercel URL here in production, e.g.:
# CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# =========================
# Clerk
# =========================
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
